generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Test {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
}

model Role {
  id           Int              @id @default(autoincrement())
  name         String           @unique
  description  String?
  displayOrder Int              @unique
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  permissions  RolePermission[]
  users        User[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  scope        PermissionScope @default(ALL)
  createdAt    DateTime        @default(now())
  permission   Permission      @relation(fields: [permissionId], references: [id])
  role         Role            @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model Team {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  managerId   String     @db.Uuid
  manager     User       @relation("TeamManager", fields: [managerId], references: [id])
  users       User[]     @relation("TeamMembers")
  leads       Lead[]
  teamLeads   TeamLead[]

  @@index([managerId])
}

model User {
  id                          String                  @id @default(uuid()) @db.Uuid
  firstName                   String
  lastName                    String?
  email                       String                  @unique
  phone                       String                  @unique
  alternatePhone              String?
  dob                         DateTime?               @db.Date
  passwordHash                String
  username                    String                  @unique
  mustChangePassword          Boolean                 @default(true)
  status                      UserStatus              @default(ACTIVE)
  roleId                      Int
  teamId                      Int?
  managerId                   String?                 @db.Uuid
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  activities                  ActivityLog[]           @relation("UserActivities")
  uploadedAttachments         Attachment[]            @relation("AttachmentUploader")
  attendance                  Attendance[]            @relation("UserAttendance")
  approvedColleges            College[]               @relation("CollegeApprover")
  createdDataAssignments      DataAssignment[]        @relation("StudentDataAssigner")
  assignedDataAssignments     DataAssignment[]        @relation("StudentDataAssignee")
  dataUploads                 DataUpload[]            @relation("DataUploader")
  createdInteractions         Interaction[]           @relation("InteractionCreator")
  conductedInterviews         Interview[]             @relation("CandidateInterviewer")
  createdLeads                Lead[]                  @relation("LeadCreator")
  leadAssignments             LeadAssignment[]
  processedClaimRequests      LeadClaimRequest[]      @relation("ClaimProcessor")
  createdClaimRequests        LeadClaimRequest[]      @relation("ClaimRequester")
  pitchedLeadApplications     LeadCollege[]           @relation("LeadCollegePitcher")
  processedLeadApplications   LeadCollege[]           @relation("LeadCollegeApprover")
  changedLeadCollegeHistories LeadCollegeHistory[]    @relation("LeadHistoryChanger")
  processedLeadPayments       LeadCollegePayment[]    @relation("LeadPaymentProcessor")
  changedLeadOwnerships       LeadOwnershipHistory[]  @relation("LeadOwnershipChanger")
  newLeadOwnerships           LeadOwnershipHistory[]  @relation("LeadNewOwner")
  previousLeadOwnerships      LeadOwnershipHistory[]  @relation("LeadPreviousOwner")
  notifications               NotificationRecipient[] @relation("NotificationRecipient")
  issuedSelectionLetters      SelectionLetter[]       @relation("SelectionLetterIssuer")
  tpcAssignmentsCreated       TPCUser[]               @relation("TPCAssignedBy")
  tpcAssignmentsReceived      TPCUser[]               @relation("TPCAssignedTo")
  tpcAssignmentsCompleted     TPCUser[]               @relation("TPCCompletedBy")
  teamsManaged                Team[]                  @relation("TeamManager")
  todos                       Todo[]                  @relation("UserTodos")
  callRecordsCreated          CallRecord[]            @relation("CallRecordsCreated")
  manager                     User?                   @relation("UserManager", fields: [managerId], references: [id])
  subordinates                User[]                  @relation("UserManager")
  role                        Role                    @relation(fields: [roleId], references: [id])
  team                        Team?                   @relation("TeamMembers", fields: [teamId], references: [id])
  teamLeads                   TeamLead[]              @relation("TeamLeadUser")
  advisors                    TeamLeadAdvisor[]       @relation("TeamLeadAdvisors")
  teamLeadAdvisors            TeamLeadAdvisor[]       @relation("AdvisorTeamLeads")
}

model TeamLead {
  teamId    Int
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation("TeamLeadUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

model TeamLeadAdvisor {
  teamLeadId String   @db.Uuid
  advisorId  String   @db.Uuid
  assignedAt DateTime @default(now())
  teamLead   User     @relation("TeamLeadAdvisors", fields: [teamLeadId], references: [id], onDelete: Cascade)
  advisor    User     @relation("AdvisorTeamLeads", fields: [advisorId], references: [id], onDelete: Cascade)

  @@id([teamLeadId, advisorId])
  @@index([advisorId])
}

model Course {
  id        Int      @id @default(autoincrement())
  collegeId String   @db.Uuid
  name      String
  fees      Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model CollegeCompetitor {
  id                  String   @id @default(uuid()) @db.Uuid
  collegeId           String   @db.Uuid
  competitorCollegeId String   @db.Uuid
  createdAt           DateTime @default(now())
  college             College  @relation("PrimaryCollege", fields: [collegeId], references: [id], onDelete: Cascade)
  competitorCollege   College  @relation("CompetitorCollege", fields: [competitorCollegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, competitorCollegeId])
}

model College {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @unique
  description        String
  contactPerson      String?
  phone              String?
  email              String?
  website            String?
  address            String?
  city               String?
  state              String?
  admissionProcess   String?
  hasTieUp           Boolean             @default(false)
  approvedById       String?             @db.Uuid
  approvedAt         DateTime            @default(now())
  isActive           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  requiresApproval   Boolean             @default(false)
  approvedBy         User?               @relation("CollegeApprover", fields: [approvedById], references: [id])
  competitors        CollegeCompetitor[] @relation("PrimaryCollege")
  competesWith       CollegeCompetitor[] @relation("CompetitorCollege")
  courses            Course[]
  finalEnrolledLeads Lead[]              @relation("FinalCollege")
  leadApplications   LeadCollege[]
  negativeLeadColleges LeadNegativeCollege[]

  @@index([approvedById])
}

model LeadStatus {
  id                Int                  @id @default(autoincrement())
  name              String               @unique
  description       String
  displayOrder      Int                  @unique
  color             String
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  leads             Lead[]
  leadCollege       LeadCollege[]
  historyFromStatus LeadCollegeHistory[] @relation("LeadHistoryFromStatus")
  historyToStatus   LeadCollegeHistory[] @relation("LeadHistoryToStatus")
}

model Lead {
  id                       String                 @id @default(uuid()) @db.Uuid
  statusId                 Int
  createdById              String                 @db.Uuid
  teamId                   Int?
  firstName                String
  lastName                 String?
  phone                    String
  alternatePhone           String?
  email                    String?
  gender                   Gender?
  dateOfBirth              DateTime?              @db.Date
  city                     String?
  state                    String?
  tenthPercentage          Float?
  twelfthPercentage        Float?
  graduationPercentage     Float?
  graduationCourse         String?
  graduationSpecialization String?
  courseInterested         CourseType?
  specializationInterested String?
  passingYear              Int?
  source                   LeadSource
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  finalCollegeId           String?                @db.Uuid
  interactions             Interaction[]
  createdBy                User                   @relation("LeadCreator", fields: [createdById], references: [id])
  team                     Team?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  finalCollege             College?               @relation("FinalCollege", fields: [finalCollegeId], references: [id], onDelete: SetNull)
  status                   LeadStatus             @relation(fields: [statusId], references: [id])
  assignments              LeadAssignment[]
  claimRequests            LeadClaimRequest[]
  collegeApplications      LeadCollege[]
  negativeColleges         LeadNegativeCollege[]
  ownershipHistories       LeadOwnershipHistory[]
  tpcs                     TPC[]
  callRecords              CallRecord[]

  @@index([statusId])
  @@index([createdById])
  @@index([teamId])
  @@index([finalCollegeId])
}

model LeadAssignment {
  id         Int                  @id @default(autoincrement())
  leadId     String               @db.Uuid
  userId     String               @db.Uuid
  assignedAt DateTime             @default(now())
  expiresAt  DateTime
  status     LeadAssignmentStatus @default(ACTIVE)
  createdAt  DateTime             @default(now())
  lead       Lead                 @relation(fields: [leadId], references: [id])
  user       User                 @relation(fields: [userId], references: [id])

  @@unique([leadId, userId, assignedAt])
}

model LeadCollege {
  id                    String                 @id @default(uuid()) @db.Uuid
  leadId                String                 @db.Uuid
  collegeId             String                 @db.Uuid
  statusId              Int
  pitchedById           String                 @db.Uuid
  processedById         String?                @db.Uuid
  approvalStatus        CollegeStatus          @default(APPROVED)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  applicationId         String?
  cancellationReason    String?
  cancelledAt           DateTime?
  coursePitched         String?
  feePitched            Decimal?               @db.Decimal(10, 2)
  isCancelled           Boolean                @default(false)
  specializationPitched String?
  college               College                @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  lead                  Lead                   @relation(fields: [leadId], references: [id])
  pitchedBy             User                   @relation("LeadCollegePitcher", fields: [pitchedById], references: [id])
  processedBy           User?                  @relation("LeadCollegeApprover", fields: [processedById], references: [id])
  status                LeadStatus             @relation(fields: [statusId], references: [id])
  history               LeadCollegeHistory[]
  interviews            LeadCollegeInterview[]
  payments              LeadCollegePayment[]
  selectionLetters      SelectionLetter[]

  @@unique([leadId, collegeId])
  @@index([leadId])
  @@index([collegeId])
  @@index([statusId])
  @@index([pitchedById])
  @@index([processedById])
  @@index([applicationId])
}

model LeadNegativeCollege {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  collegeId String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([leadId, collegeId])
  @@index([leadId])
  @@index([collegeId])
}

model Interaction {
  id          String       @id @default(uuid()) @db.Uuid
  leadId      String       @db.Uuid
  createdById String       @db.Uuid
  title       String?
  description String
  createdAt   DateTime     @default(now())
  attachments Attachment[]
  createdBy   User         @relation("InteractionCreator", fields: [createdById], references: [id])
  lead        Lead         @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@index([createdById])
}

model Attachment {
  id            String      @id @default(uuid()) @db.Uuid
  interactionId String      @db.Uuid
  uploadedById  String      @db.Uuid
  fileName      String
  fileUrl       String
  fileType      String
  fileSize      Int
  uploadedAt    DateTime    @default(now())
  interaction   Interaction @relation(fields: [interactionId], references: [id])
  uploadedBy    User        @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  @@index([interactionId])
  @@index([uploadedById])
}

model TPC {
  id          String    @id @default(uuid()) @db.Uuid
  leadId      String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignments TPCUser[]

  @@index([leadId])
}

model TPCUser {
  id            String        @id @default(uuid()) @db.Uuid
  tpcId         String        @db.Uuid
  assignedById  String        @db.Uuid
  assignedToId  String        @db.Uuid
  completedById String?       @db.Uuid
  assignedAt    DateTime      @default(now())
  completedAt   DateTime?
  status        TPCUserStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  assignedBy    User          @relation("TPCAssignedBy", fields: [assignedById], references: [id])
  assignedTo    User          @relation("TPCAssignedTo", fields: [assignedToId], references: [id])
  completedBy   User?         @relation("TPCCompletedBy", fields: [completedById], references: [id])
  tpc           TPC           @relation(fields: [tpcId], references: [id], onDelete: Cascade)

  @@index([tpcId])
  @@index([assignedById])
  @@index([assignedToId])
  @@index([completedById])
}

model Position {
  id          Int         @id @default(autoincrement())
  title       String      @unique
  department  String
  description String?
  vacancies   Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  candidates  Candidate[]
}

model Candidate {
  id             String          @id @default(uuid()) @db.Uuid
  positionId     Int
  firstName      String
  lastName       String?
  phone          String          @unique
  alternatePhone String?
  email          String?         @unique
  gender         Gender?
  dateOfBirth    DateTime?       @db.Date
  resumeUrl      String?
  experience     Int?
  currentCompany String?
  status         CandidateStatus @default(APPLIED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  position       Position        @relation(fields: [positionId], references: [id])
  interviews     Interview[]
}

model Interview {
  id            String          @id @default(uuid()) @db.Uuid
  candidateId   String          @db.Uuid
  interviewerId String          @db.Uuid
  scheduledAt   DateTime
  status        InterviewStatus @default(SCHEDULED)
  result        InterviewResult @default(PENDING)
  feedback      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  candidate     Candidate       @relation(fields: [candidateId], references: [id])
  interviewer   User            @relation("CandidateInterviewer", fields: [interviewerId], references: [id])

  @@index([candidateId])
  @@index([interviewerId])
}

model DataUpload {
  id           String           @id @default(uuid()) @db.Uuid
  uploadedById String           @db.Uuid
  fileName     String
  fileUrl      String
  totalRecords Int
  status       DataUploadStatus @default(PROCESSING)
  uploadedAt   DateTime         @default(now())
  uploadedBy   User             @relation("DataUploader", fields: [uploadedById], references: [id])
  studentData  StudentData[]

  @@index([uploadedById])
}

model StudentData {
  id              String               @id @default(uuid()) @db.Uuid
  uploadId        String               @db.Uuid
  firstName       String
  middleName      String?
  lastName        String?
  phone           String
  email           String?
  city            String?
  state           String?
  createdAt       DateTime             @default(now())
  assignmentItems DataAssignmentItem[]
  upload          DataUpload           @relation(fields: [uploadId], references: [id])
  callRecords     CallRecord[]

  @@index([uploadId])
  @@index([phone])
}

model DataAssignment {
  id           String               @id @default(uuid()) @db.Uuid
  assignedToId String               @db.Uuid
  assignedById String               @db.Uuid
  assignedAt   DateTime             @default(now())
  expiresAt    DateTime
  status       DataAssignmentStatus @default(ACTIVE)
  createdAt    DateTime             @default(now())
  reclaimedAt  DateTime?
  assignedBy   User                 @relation("StudentDataAssigner", fields: [assignedById], references: [id])
  assignedTo   User                 @relation("StudentDataAssignee", fields: [assignedToId], references: [id])
  items        DataAssignmentItem[]

  @@index([assignedToId])
  @@index([assignedById])
}

model DataAssignmentItem {
  id               Int            @id @default(autoincrement())
  dataAssignmentId String         @db.Uuid
  studentDataId    String         @db.Uuid
  assignment       DataAssignment @relation(fields: [dataAssignmentId], references: [id])
  studentData      StudentData    @relation(fields: [studentDataId], references: [id])

  @@unique([dataAssignmentId, studentDataId])
  @@index([studentDataId])
}

model Notification {
  id         String                  @id @default(uuid()) @db.Uuid
  title      String
  message    String
  type       NotificationType
  createdAt  DateTime                @default(now())
  recipients NotificationRecipient[]
}

model NotificationRecipient {
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String       @db.Uuid
  userId         String       @db.Uuid
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id])
  user           User         @relation("NotificationRecipient", fields: [userId], references: [id])

  @@unique([notificationId, userId])
  @@index([notificationId])
  @@index([userId])
}

model ActivityLog {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  activity    ActivityType
  entityType  String
  entityId    String
  description String?
  createdAt   DateTime     @default(now())
  user        User         @relation("UserActivities", fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
}

model Office {
  id                        Int               @id @default(autoincrement())
  name                      String            @unique
  address                   String?
  city                      String?
  state                     String?
  latitude                  Float?
  longitude                 Float?
  radiusMeters              Int               @default(100)
  isActive                  Boolean           @default(true)
  locationValidationEnabled Boolean           @default(true)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  attendance                Attendance[]
  attendancePolicy          AttendancePolicy?
}

model AttendancePolicy {
  id                Int      @id @default(autoincrement())
  officeId          Int      @unique
  officeStartTime   String
  officeEndTime     String
  casualLeaveCutoff String
  halfDayCutoff     String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  office            Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
}

model Attendance {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  officeId  Int
  date      DateTime         @db.Date
  checkIn   DateTime?
  checkOut  DateTime?
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  office    Office           @relation(fields: [officeId], references: [id])
  user      User             @relation("UserAttendance", fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([officeId])
}

model Holiday {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

model Todo {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  title       String
  description String?
  dueDate     DateTime @db.Date
  isCompleted Boolean  @default(false)
  priority    String   @default("MEDIUM")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation("UserTodos", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dueDate])
}

model LeadCollegeInterview {
  id                String                 @id @default(uuid()) @db.Uuid
  leadCollegeId     String                 @db.Uuid
  scheduledAt       DateTime
  conductedAt       DateTime?
  status            LeadInterviewStatus    @default(SCHEDULED)
  result            LeadInterviewResult    @default(PENDING)
  feedback          String?
  meetingLink       String?
  rescheduledFromId String?                @db.Uuid
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  leadCollege       LeadCollege            @relation(fields: [leadCollegeId], references: [id], onDelete: Cascade)
  rescheduledFrom   LeadCollegeInterview?  @relation("RescheduledInterviews", fields: [rescheduledFromId], references: [id])
  rescheduledTo     LeadCollegeInterview[] @relation("RescheduledInterviews")

  @@index([leadCollegeId])
  @@index([scheduledAt])
  @@index([status])
  @@index([rescheduledFromId])
}

model SelectionLetter {
  id                String      @id @default(uuid()) @db.Uuid
  leadCollegeId     String      @db.Uuid
  letterUrl         String?
  issuedAt          DateTime
  admissionLastDate DateTime
  issuedById        String?     @db.Uuid
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  issuedBy          User?       @relation("SelectionLetterIssuer", fields: [issuedById], references: [id])
  leadCollege       LeadCollege @relation(fields: [leadCollegeId], references: [id], onDelete: Cascade)

  @@index([leadCollegeId])
  @@index([issuedAt])
  @@index([admissionLastDate])
  @@index([issuedById])
}

model LeadCollegePayment {
  id              String               @id @default(uuid()) @db.Uuid
  leadCollegeId   String               @db.Uuid
  type            LeadPaymentType
  amount          Decimal              @db.Decimal(10, 2)
  transactionRef  String?
  paymentMode     String?
  paidAt          DateTime             @default(now())
  remarks         String?
  processedById   String?              @db.Uuid
  parentPaymentId String?              @db.Uuid
  refundStatus    LeadRefundStatus?
  createdAt       DateTime             @default(now())
  leadCollege     LeadCollege          @relation(fields: [leadCollegeId], references: [id], onDelete: Cascade)
  parentPayment   LeadCollegePayment?  @relation("PaymentRefunds", fields: [parentPaymentId], references: [id])
  refunds         LeadCollegePayment[] @relation("PaymentRefunds")
  processedBy     User?                @relation("LeadPaymentProcessor", fields: [processedById], references: [id])

  @@index([leadCollegeId])
  @@index([paidAt])
  @@index([type])
  @@index([parentPaymentId])
  @@index([refundStatus])
  @@index([processedById])
}

model LeadCollegeHistory {
  id            String      @id @default(uuid()) @db.Uuid
  leadCollegeId String      @db.Uuid
  fromStatusId  Int?
  toStatusId    Int
  changedById   String?     @db.Uuid
  remarks       String?
  createdAt     DateTime    @default(now())
  changedBy     User?       @relation("LeadHistoryChanger", fields: [changedById], references: [id])
  fromStatus    LeadStatus? @relation("LeadHistoryFromStatus", fields: [fromStatusId], references: [id])
  leadCollege   LeadCollege @relation(fields: [leadCollegeId], references: [id], onDelete: Cascade)
  toStatus      LeadStatus  @relation("LeadHistoryToStatus", fields: [toStatusId], references: [id])

  @@index([leadCollegeId])
  @@index([createdAt])
  @@index([fromStatusId])
  @@index([toStatusId])
  @@index([changedById])
}

model LeadClaimRequest {
  id            String             @id @default(uuid()) @db.Uuid
  leadId        String             @db.Uuid
  requestedAt   DateTime           @default(now())
  status        ClaimRequestStatus @default(PENDING)
  remarks       String?
  processedAt   DateTime?
  processedById String?            @db.Uuid
  requestedById String             @db.Uuid
  lead          Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  processedBy   User?              @relation("ClaimProcessor", fields: [processedById], references: [id])
  requestedBy   User               @relation("ClaimRequester", fields: [requestedById], references: [id])

  @@index([leadId])
  @@index([requestedById])
  @@index([status])
}

model LeadOwnershipHistory {
  id              String                @id @default(uuid()) @db.Uuid
  leadId          String                @db.Uuid
  previousOwnerId String?               @db.Uuid
  newOwnerId      String                @db.Uuid
  changedById     String                @db.Uuid
  reason          OwnershipChangeReason
  createdAt       DateTime              @default(now())
  changedBy       User                  @relation("LeadOwnershipChanger", fields: [changedById], references: [id], onDelete: Cascade)
  lead            Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  newOwner        User                  @relation("LeadNewOwner", fields: [newOwnerId], references: [id], onDelete: Cascade)
  previousOwner   User?                 @relation("LeadPreviousOwner", fields: [previousOwnerId], references: [id])

  @@index([leadId])
  @@index([newOwnerId])
  @@index([createdAt])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LeadAssignmentStatus {
  ACTIVE
