model CallRecord {
  id              String      @id @default(uuid()) @db.Uuid
  studentDataId   String      @db.Uuid
  leadId          String?     @db.Uuid
  createdById     String      @db.Uuid
  outcome         CallOutcome
  notes           String?
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  createdAt       DateTime    @default(now())

  studentData StudentData @relation(fields: [studentDataId], references: [id])
  lead        Lead?       @relation(fields: [leadId], references: [id])
  createdBy   User        @relation("CallRecordsCreated", fields: [createdById], references: [id])

  @@index([studentDataId])
  @@index([leadId])
  @@index([createdById])
  @@index([createdAt])
}
