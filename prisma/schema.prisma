generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LeadAssignmentStatus {
  ACTIVE
  EXPIRED
  COMPLETED
  CANCELLED
}

enum CollegeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CourseType {
  MBA
  PGDM
  MCA
  BBA
}

enum LeadSource {
  WEBSITE
  FACEBOOK
  INSTAGRAM
  GOOGLE
  REFERRAL
  DATA_UPLOAD
  COLLEGE_EVENT
  OTHER
}

enum LeadStatusType {
  NEW
  APPLICATION
  INTERVIEW_SCHEDULED
  INTERVIEW_DONE
  LETTER_OUT
  ADMISSION_DONE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum TPCUserStatus {
  ACTIVE
  COMPLETED
}

enum TPCStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum InteractionType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
}

enum CandidateStatus {
  APPLIED
  SCREENING
  INTERVIEW_SCHEDULED
  INTERVIEWED
  SELECTED
  REJECTED
  HIRED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum InterviewResult {
  PENDING
  PASSED
  FAILED
  ON_HOLD
}

enum DataUploadStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum DataAssignmentStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum NotificationType {
  LEAD
  TPC
  DATA_ASSIGNMENT
  INTERVIEW
  SYSTEM
}

enum ActivityType {
  USER

  LEAD
  COLLEGE

  DATA_UPLOAD
  DATA_ASSIGNMENT

  TPC

  CANDIDATE
  INTERVIEW

  NOTIFICATION

  ATTENDANCE

  SYSTEM
}

//MODELS

model Test {
  id   Int    @id @default(autoincrement())
  name String

  createdAt DateTime @default(now())
}

model Role {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  description  String?
  displayOrder Int     @unique
  isActive     Boolean @default(true)

  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  firstName      String
  lastName       String?
  email          String    @unique
  phone          String    @unique
  alternatePhone String?
  dob            DateTime? @db.Date
  passwordHash   String
  username       String    @unique

  mustChangePassword Boolean @default(true)

  status UserStatus @default(ACTIVE)

  roleId    Int
  teamId    Int
  managerId String? @db.Uuid

  role Role @relation(fields: [roleId], references: [id])

  team Team @relation(fields: [teamId], references: [id])

  manager      User?  @relation("UserManager", fields: [managerId], references: [id])
  subordinates User[] @relation("UserManager")

  uploadedAttachments Attachment[] @relation("AttachmentUploader")

  approvedColleges        College[]               @relation("CollegeApprover")
  createdLeads            Lead[]                  @relation("LeadCreator")
  createdInteractions     Interaction[]           @relation("InteractionCreator")
  tpcHistory              TPCUser[]               @relation("TPCUserHistory")
  assignedTPCs            TPC[]                   @relation("TPCAssignee")
  conductedInterviews     Interview[]             @relation("CandidateInterviewer")
  assignedDataAssignments DataAssignment[]        @relation("StudentDataAssignee")
  dataUploads             DataUpload[]            @relation("DataUploader")
  notifications           NotificationRecipient[] @relation("NotificationRecipient")
  activities              ActivityLog[]           @relation("UserActivities")
  createdDataAssignments  DataAssignment[]        @relation("StudentDataAssigner")
  attendance              Attendance[]            @relation("UserAttendance")

  leadAssignments LeadAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// College Model 

model Course {
  id Int @id @default(autoincrement())

  collegeId String @db.Uuid

  name String
  fees Decimal @db.Decimal(10, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id])
}

model CollegeCompetitor {
  id String @id @default(uuid()) @db.Uuid

  collegeId           String @db.Uuid
  competitorCollegeId String @db.Uuid

  createdAt DateTime @default(now())

  college College @relation("PrimaryCollege", fields: [collegeId], references: [id])

  competitorCollege College @relation("CompetitorCollege", fields: [competitorCollegeId], references: [id])

  @@unique([collegeId, competitorCollegeId])
}

model College {
  id String @id @default(uuid()) @db.Uuid

  name        String @unique
  description String

  contactPerson String?
  phone         String?
  email         String?
  website       String?

  address String?
  city    String?
  state   String?

  admissionProcess String?

  hasTieUp Boolean @default(false)

  approvedById String?  @db.Uuid
  approvedAt   DateTime @default(now())

  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  approvedBy User? @relation("CollegeApprover", fields: [approvedById], references: [id])

  courses Course[]

  competitors  CollegeCompetitor[] @relation("PrimaryCollege")
  competesWith CollegeCompetitor[] @relation("CompetitorCollege")

  @@index([approvedById])
}

// LEADS

model LeadStatus {
  id Int @id @default(autoincrement())

  name        String @unique
  description String

  displayOrder Int @unique

  color String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]
}

model Lead {
  id String @id @default(uuid()) @db.Uuid

  statusId    Int
  createdById String @db.Uuid

  firstName String
  lastName  String?

  phone          String
  alternatePhone String?

  email String?

  gender      Gender?
  dateOfBirth DateTime? @db.Date

  city  String?
  state String?

  tenthPercentage      Float?
  twelfthPercentage    Float?
  graduationPercentage Float?

  graduationCourse         String?
  graduationSpecialization String?

  courseInterested         CourseType?
  specializationInterested String?

  passingYear Int?

  source       LeadSource
  interactions Interaction[]
  tpcs         TPC[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  status    LeadStatus @relation(fields: [statusId], references: [id])
  createdBy User       @relation("LeadCreator", fields: [createdById], references: [id])

  assignments LeadAssignment[]

  @@index([statusId])
  @@index([createdById])
}

model LeadAssignment {
  id Int @id @default(autoincrement())

  leadId String @db.Uuid
  userId String @db.Uuid

  assignedAt DateTime @default(now())
  expiresAt  DateTime

  status LeadAssignmentStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  // Relationships
  lead Lead @relation(fields: [leadId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([leadId, userId, assignedAt])
}

model Interaction {
  id String @id @default(uuid()) @db.Uuid

  leadId      String @db.Uuid
  createdById String @db.Uuid

  title       String?
  description String

  createdAt DateTime @default(now())

  // Relationships
  lead      Lead @relation(fields: [leadId], references: [id])
  createdBy User @relation("InteractionCreator", fields: [createdById], references: [id])

  attachments Attachment[]

  @@index([leadId])
  @@index([createdById])
}

model Attachment {
  id String @id @default(uuid()) @db.Uuid

  interactionId String @db.Uuid
  uploadedById  String @db.Uuid

  fileName String
  fileUrl  String
  fileType String
  fileSize Int

  uploadedAt DateTime @default(now())

  // Relationships
  interaction Interaction @relation(fields: [interactionId], references: [id])
  uploadedBy  User        @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  @@index([interactionId])
  @@index([uploadedById])
}

model TPC {
  id String @id @default(uuid()) @db.Uuid

  leadId       String @db.Uuid
  assignedToId String @db.Uuid

  status TPCStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  lead       Lead @relation(fields: [leadId], references: [id])
  assignedTo User @relation("TPCAssignee", fields: [assignedToId], references: [id])

  users TPCUser[]
}

model TPCUser {
  id String @id @default(uuid()) @db.Uuid

  tpcId  String @db.Uuid
  userId String @db.Uuid

  assignedAt DateTime @default(now())

  status TPCUserStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  // Relationships
  tpc  TPC  @relation(fields: [tpcId], references: [id])
  user User @relation("TPCUserHistory", fields: [userId], references: [id])

  @@index([tpcId])
  @@index([userId])
}

model Position {
  id Int @id @default(autoincrement())

  title       String  @unique
  department  String
  description String?

  vacancies Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  candidates Candidate[]
}

model Candidate {
  id String @id @default(uuid()) @db.Uuid

  positionId Int

  firstName String
  lastName  String?

  phone          String  @unique
  alternatePhone String?

  email String? @unique

  gender      Gender?
  dateOfBirth DateTime? @db.Date

  resumeUrl String?

  experience     Int? // Years of experience
  currentCompany String?

  status CandidateStatus @default(APPLIED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  position Position @relation(fields: [positionId], references: [id])

  interviews Interview[]
}

model Interview {
  id String @id @default(uuid()) @db.Uuid

  candidateId   String @db.Uuid
  interviewerId String @db.Uuid

  scheduledAt DateTime

  status InterviewStatus @default(SCHEDULED)
  result InterviewResult @default(PENDING)

  feedback String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  candidate Candidate @relation(fields: [candidateId], references: [id])

  interviewer User? @relation("CandidateInterviewer", fields: [interviewerId], references: [id])

  @@index([candidateId])
  @@index([interviewerId])
}

model DataUpload {
  id String @id @default(uuid()) @db.Uuid

  uploadedById String @db.Uuid

  fileName String
  fileUrl  String

  totalRecords Int

  status DataUploadStatus @default(PROCESSING)

  uploadedAt DateTime @default(now())

  // Relationships
  uploadedBy User @relation("DataUploader", fields: [uploadedById], references: [id])

  studentData StudentData[]

  @@index([uploadedById])
}

model StudentData {
  id String @id @default(uuid()) @db.Uuid

  uploadId String @db.Uuid

  firstName  String
  middleName String?
  lastName   String?

  phone String
  email String?

  city  String?
  state String?

  createdAt DateTime @default(now())

  // Relationships
  upload DataUpload @relation(fields: [uploadId], references: [id])

  assignmentItems DataAssignmentItem[]

  @@index([uploadId])
  @@index([phone])
}

model DataAssignment {
  id String @id @default(uuid()) @db.Uuid

  assignedToId String @db.Uuid
  assignedById String @db.Uuid

  assignedAt DateTime @default(now())
  expiresAt  DateTime

  status DataAssignmentStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  // Relationships
  assignedTo User @relation("StudentDataAssignee", fields: [assignedToId], references: [id])

  assignedBy User @relation("StudentDataAssigner", fields: [assignedById], references: [id])

  items DataAssignmentItem[]

  @@index([assignedToId])
  @@index([assignedById])
}

model DataAssignmentItem {
  id Int @id @default(autoincrement())

  dataAssignmentId String @db.Uuid
  studentDataId    String @db.Uuid

  // Relationships
  assignment  DataAssignment @relation(fields: [dataAssignmentId], references: [id])
  studentData StudentData    @relation(fields: [studentDataId], references: [id])

  @@unique([dataAssignmentId, studentDataId])
  @@index([studentDataId])
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  title   String
  message String

  type NotificationType

  createdAt DateTime @default(now())

  // Relationships
  recipients NotificationRecipient[]
}

model NotificationRecipient {
  id String @id @default(uuid()) @db.Uuid

  notificationId String @db.Uuid
  userId         String @db.Uuid

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  // Relationships
  notification Notification @relation(fields: [notificationId], references: [id])

  user User @relation("NotificationRecipient", fields: [userId], references: [id])

  @@unique([notificationId, userId])
  @@index([notificationId])
  @@index([userId])
}

model ActivityLog {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  activity ActivityType

  entityType String
  entityId   String

  description String?

  createdAt DateTime @default(now())

  // Relationships
  user User @relation("UserActivities", fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
}

model Office {
  id Int @id @default(autoincrement())

  name String @unique

  address String?

  city  String?
  state String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  attendance Attendance[]
}

model Attendance {
  id String @id @default(uuid()) @db.Uuid

  userId   String @db.Uuid
  officeId Int

  date DateTime @db.Date

  checkIn  DateTime?
  checkOut DateTime?

  status AttendanceStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user   User   @relation("UserAttendance", fields: [userId], references: [id])
  office Office @relation(fields: [officeId], references: [id])

  @@unique([userId, date])
  @@index([officeId])
}
